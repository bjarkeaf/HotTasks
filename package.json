{
  "name": "hottasks",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "A follow-up tracker where the main view is how long since you last touched each thing",
  "license": "MIT",
  "workspaces": [
    "core",
    "frontends/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
